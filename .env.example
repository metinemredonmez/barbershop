DATABASE_URL="file:./dev.db"

# Admin paneli için şifre — production'da güçlü şifreyle değiştir
ADMIN_PASSWORD="change-me"

# Berber bilgileri (UI'da gösterilir)
NEXT_PUBLIC_BARBER_NAME="Oğulcan Ateş"
NEXT_PUBLIC_BARBER_BRAND="OĞULCAN ATEŞ"
NEXT_PUBLIC_BARBER_TAGLINE="Barber's Club"
NEXT_PUBLIC_BARBER_PHONE="0552 117 01 61"
NEXT_PUBLIC_BARBER_WHATSAPP="905521170161"
NEXT_PUBLIC_BARBER_INSTAGRAM="ogulcanatesofficial"
NEXT_PUBLIC_BARBER_ADDRESS="Feyzullah Mah. 34843, Maltepe / İstanbul"
NEXT_PUBLIC_BARBER_MAP="https://www.google.com/maps?q=Feyzullah+Mah.+Maltepe+%C4%B0stanbul&output=embed"

# --- SMS bildirimleri ---
# Boş bırakırsan SMS atılmaz, sadece console.log düşer (dev için OK).
# Provider seç: "twilio" veya "netgsm"
SMS_PROVIDER=""

# Berbere bildirim gönderilecek telefon(lar). Birden fazlaysa virgülle ayır.
# Örn: "+905521170161" veya "+905521170161,+905555555555"
SMS_BARBER_TO=""

# 1 yaparsan müşteriye de onay SMS'i gider. Boş/0 = sadece berbere gider.
SMS_NOTIFY_CUSTOMER="0"

# Twilio (SMS_PROVIDER=twilio için)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Netgsm (SMS_PROVIDER=netgsm için)
NETGSM_USERNAME=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""

# --- OneSignal push bildirimi (ücretsiz) ---
# App ID herkese açık olabilir, SDK init için public.
NEXT_PUBLIC_ONESIGNAL_APP_ID="fc33c671-fc2e-42cc-a313-29abcc5cbe22"

# REST API key SADECE server-side. OneSignal Dashboard > Settings > Keys & IDs
# Boş bırakırsan push gönderilmez (sadece log düşer).
ONESIGNAL_REST_API_KEY=""

# (Opsiyonel) Push'a tıklayınca açılacak URL'in kökü, örn. https://ogulcanates.com
NEXT_PUBLIC_SITE_URL=""
